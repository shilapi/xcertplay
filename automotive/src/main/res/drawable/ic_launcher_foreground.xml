<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: a display with a play triangle punched out of it, i.e. the CarPlay
  receiver in one glyph. Replaces the stock Android Studio template (the white Android robot head).

  The mark spans x 25..83 and y 29..79, which sits inside the 66dp adaptive-icon safe zone
  (21..87) with room to spare, so no launcher mask clips it. It is built from two subpaths and
  filled with `evenOdd` so the triangle is a real hole and the mint gradient shows through, rather
  than being painted in a flat approximation of it. Solid shapes are used deliberately: a stroked
  outline would thin out to under 3dp once the icon is drawn at 48dp.

  NOTE: keep a double hyphen out of these comments. XML forbids it inside a comment and AAPT2
  fails the whole resource merge with a bare "ParseError".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M36,29 H72 A11,11 0 0 1 83,40 V68 A11,11 0 0 1 72,79 H36 A11,11 0 0 1 25,68 V40 A11,11 0 0 1 36,29 Z M38,40 L38,68 L70,54 Z" />
</vector>
