<?xml version="1.0" encoding="utf-8"?><!--
   Backup and transfer rules for Android 12 and later.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Private copies of local MFi certificates and private keys never leave the head unit. -->
    <cloud-backup>
        <exclude domain="file" path="mfi/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="mfi/" />
    </device-transfer>
</data-extraction-rules>
